MainWindow
  id: changeChannelNameWindow
  !text: tr("Change Name")
  width: 260
  height: 120
  @onEscape: self:hide()

  Label
    id: channelNameLabel
    !text: tr("Channel Name")
    text-auto-resize: true
    anchors.left: parent.left
    anchors.top: parent.top

  TextEdit
    id: channelNameTextEdit
    anchors.left: prev.left
    anchors.top: prev.bottom
    anchors.right: parent.right
    margin-top: 5

  UIButton
    id: okButton
    !text: tr("Ok")
    width: 80
    anchors.right: next.left
    anchors.bottom: parent.bottom
    margin-right: 5

  UIButton
    id: cancelButton
    !text: tr("Cancel")
    width: 80
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: self:getParent():hide()