PanelCustomTitle < PanelRoundedSolid
  image-color: #626262
  phantom: false
  padding: 10
  id: 0
  @onClick: modules.game_outfit.onTitleSelect(self)

  $focus:
    image-color: #057FFA

  Label-14px-Medium
    id: name
    text: title
    text-auto-resize: true
    text-align: center
    anchors.centerIn: parent
    margin-left: 5
    phantom: true

CustomTitleGrid < ScrollablePanel
  layout:
    type: grid
    cell-size: 245 52
    cell-spacing: 4
    flow: true

Panel
  id: titlesPanel

  CustomTitleGrid
    id: list
    anchors.fill: parent
    anchors.right: next.left
    vertical-scrollbar: scroll

  VerticalScrollBar
    id: scroll
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 14
    pixels-scroll: true
    visible: false