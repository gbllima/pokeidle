OutfitCustomPreviewPanel < PanelRoundedSolid
  width: 182
  padding: 18 17
  image-color: #6E6E6E

  Label-16px-Bold
    id: title
    anchors.bottom: next.top
    anchors.left: parent.left
    anchors.right: parent.right
    text-auto-resize: true
    text-align: center
    text-wrap: true
    stroke: 1 #000000
    margin-bottom: -3

  Label-16px-Bold
    id: name
    anchors.bottom: next.top
    anchors.left: parent.left
    anchors.right: parent.right
    text-auto-resize: true
    text-align: center
    text-wrap: true
    stroke: 1 #000000
    margin-bottom: 12

  Creature
    id: outfit
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: next.top
    margin-bottom: 18
    &direction: 2

  ButtonBlueBase
    size: 28 28
    anchors.right: parent.horizontalCenter
    anchors.bottom: next.bottom
    icon: /images/game/outfits/icon_rotate
    margin-right: 4
    !tooltip: tr('Rotate')
    @onClick: |
      local parent = self:getParent()
      parent.outfit.direction = (parent.outfit.direction + 1) % 4
      parent.outfit:setDirection(parent.outfit.direction)

  ButtonBlueBase
    size: 28 28
    anchors.left: parent.horizontalCenter
    anchors.bottom: next.top
    icon: /images/game/icons/pokeinfo
    icon-clip: 0 44 22 22
    icon-color: #FFFFFF
    margin: 0 4 16 0
    !tooltip: tr('Walking')
    @onClick: |
      local parent = self:getParent()
      self:setOn(not self:isOn())
      parent.outfit:setAnimate(self:isOn())

    $on:
      icon-color: #A8FF80

  ButtonBlueSmall
    id: confirm
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    !text: tr('Confirm')
    @onClick: modules.game_outfit.confirmChoose()

  UIWidget
    id: texture
    anchors.fill: name

OutfitCustomTabBarVertical < TabBarVertical
OutfitCustomTabBarVerticalPanel < TabBarVerticalPanel
OutfitCustomTabBarVerticalButton < TabBarVerticalButton
  text-only-upper-case: false
  text-align: center
  text-offset: 0 0

MainWindow
  size: 880 355
  anchors.centerIn: parent
  !text: tr('Customize Trainer')
  @onEscape: modules.game_outfit.destroy()
  @onClose: modules.game_outfit.destroy()

  OutfitCustomPreviewPanel
    id: previewPanel
    anchors.top: prev.bottom
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin: 18 0 10 0

  OutfitCustomTabBarVertical
    id: mainTabBar
    width: 140
    anchors.top: prev.top
    anchors.left: parent.left
    anchors.bottom: prev.bottom

  Panel
    id: mainTabContent
    anchors.top: prev.top
    anchors.left: prev.right
    anchors.right: previewPanel.left
    anchors.bottom: prev.bottom
    margin: 0 8 0 8