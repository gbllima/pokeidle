ChoosePanel < Panel
  height: 115
  text-align: top
  font: DMSans-16px-bold

ChoosePokemon < UIWidget
  size: 90 95
  image-source: /images/ui/panel_outline
  image-border: 12
  image-clip: 0 0 170 60
  anchors.bottom: parent.bottom
  anchors.left: parent.left
  @onClick: |
    function(selectedWidget)
      local pokemonList = selectedWidget:getParent():getParent()
      if selectedWidget == pokemonList.selectedWidget then return end

      local previousSelectedWidget = pokemonList.selectedWidget
      pokemonList.selectedWidget = selectedWidget

      if previousSelectedWidget then
        previousSelectedWidget:setOn(false)
      end

      if selectedWidget then
        selectedWidget:setOn(true)
      end
    end

  $hover:
    image-clip: 0 60 170 60

  $on:
    image-clip: 0 120 170 60

  $on hover:
    image-clip: 0 60 170 60

  $!first:
    anchors.left: prev.right
    margin-left: 8

  UIWidget
    id: image
    size: 80 90
    anchors.centerIn: parent
    anchors.top: parent.top
    anchors.bottom: next.top
    margin: 12 0 4 0
    phantom: true

  Label-14px-Medium
    id: name
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    text-auto-resize: true

MainWindow
  size: 625 495
  !text: tr('Choose you pokemon')
  @onEscape: modules.game_pokeinicial.destroy()
  @onClose: modules.game_pokeinicial.destroy()

  ScrollablePanel
    id: pokemonList
    anchors.fill: parent
    anchors.top: prev.bottom
    anchors.bottom: next.top
    margin-top: 18

  ButtonBlueSmall
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    !text: tr('Choose')
    @onClick: modules.game_pokeinicial.choosePokemon()
