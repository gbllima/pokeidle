CountWindow < MainHeadlessWindow
  id: countWindow
  size: 272 171
  !text: tr('Move Itens')

  SpinBox
    id: spinBox
    size: 1 1
    anchors.left: parent.left
    anchors.top: prev.bottom
    phantom: true
    margin: 32 0 0 24
    focusable: true
    opacity: 0

  UIItem
    id: item
    size: 32 32
    anchors.left: parent.left
    anchors.bottom: buttonOk.top
    margin: 0 0 16 12
    focusable: false
    virtual: true
    font: verdana-11px-rounded
    show-count: false

  HorizontalScrollBar
    id: countScrollBar
    anchors.left: prev.right
    anchors.right: parent.right
    anchors.verticalCenter: prev.verticalCenter
    margin: 0 20 0 8
    focusable: false
    show-value: true
    step: 1
    @onConfig: |
      self.decrementButton:show()
      self.incrementButton:show()
      self.valueLabel:show()

  Label-13px-Regular
    id: extraLabel
    anchors.bottom: next.top
    anchors.horizontalCenter: parent.horizontalCenter
    text-auto-resize: true
    margin-bottom: 6
    visible: false

  ButtonRedSmall
    id: buttonCancel
    anchors.bottom: parent.bottom
    anchors.left: parent.horizontalCenter
    margin-left: 5
    focusable: false
    !text: tr('Cancel')

  ButtonBlueSmall
    id: buttonOk
    anchors.bottom: parent.bottom
    anchors.right: parent.horizontalCenter
    margin-right: 5
    focusable: false
    !text: tr('Confirm')
