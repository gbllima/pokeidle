Module
  name: game_interface
  description: Create the game interface, where the ingame stuff starts
  author: OTClient team
  website: https://github.com/edubart/otclient
  sandboxed: true
  scripts: [ widgets/uigamemap, gameinterface ]
  load-later:
    - game_hotkeys
    - game_questlog
    - game_textmessage
    - game_console
    - game_outfit
    - game_skills
    - game_inventory
    - game_containers
    - game_viplist
    - game_battle
    - game_pokebar
    - game_minimap
    - game_npctrade
    - game_pokeinfo
    - game_textwindow
    - game_playertrade
    - game_playerdeath
    - game_ruleviolation
    - game_modaldialog
    - game_walking
    - game_highscore
    - game_offset
    - game_minigame
    - game_shop
    - client_textedit
    - game_actionbar
    - game_shaders
    - game_autoloot
    - game_dex
    - game_notification
    - game_pokeinicial
    - game_scout
    - game_dialog
    - game_workshop
    - game_pokeprey
    - game_market
    - game_analytics
    - game_contract
    - game_evolutions
    - game_pokemoves
    - game_dailyreward
    - game_memory
    - game_eventdungeon
    - game_traininglevel
    - game_bank
    - game_starboost
    - game_playerbar
    - game_house
    - game_api
    - game_accounts
    - game_daily
    - game_pokemonseller
    - game_messageboxparser
    - game_fossil
    - game_custompokemon
    - game_twitchdrops
    - game_minitask
    - game_playerbar
    - game_helds
    - game_pokegear
    - game_expedition
  @onLoad: init()
  @onUnload: terminate()
