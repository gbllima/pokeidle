ScoutTracker < MiniWindow
  id: scoutTrackerWindow
  height: 160
  !text: tr('Scout Tracker')
  icon: /images/game/icons/icons_tree
  icon-clip: 413 -1 25 25
  visible: false

  MiniWindowContents
    layout: verticalBox
    padding: 5 5 0 5

RowItem < UIItem
  size: 26 26
  virtual: true

RankButton < ButtonBlueMedium         
  size: 105 40
  color: #8b8a8a
  text-align: center
  enabled: false
  font: DMSans-14px-regular
  @onClick: modules.game_scout.requestRank(self:getId())

  $hover !on:
    color: white

  $on:
    color: white

ButtonScoutRank < TabButton
  font: DMSans-14px-regular
  text-auto-resize: true
  padding: 11 14 11 14
  @onClick: |
    if ( not self:isChecked() ) then
      modules.game_scout.requestRank(self:getId())
    end

  $!first:
    margin-left: 4

RowPanel < PanelRoundedSolid
  image-color: #525252
  padding: 6

  $on:
    image-color: #FF6C3E

  $checked:
    image-color: #009C48

  $focus !on:
    image-color: #057FFA

  $focus:
    //image-color: #1ABC65
    //image-color: #057FFA

  UICreature
    id: creature
    size: 45 45
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: parent.left
    margin: 8 0 0 10

  Label-13px-Bold
    id: name
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 5
    text-auto-resize: true

  Panel
    id: panelDefeats
    size: 74 83
    anchors.top: parent.top
    anchors.left: creature.right
    padding: 10
    margin-left: 21

    Label-13px-Bold
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 11
      !text: tr('Derrote:')

    Label-14px-Regular
      id: count
      anchors.top: prev.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 8

  Panel
    id: panelPoints
    anchors.fill: parent
    anchors.left: prev.right
    margin-left: 4
    padding: 10


    UIWidget
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 9
      image-source: /images/game/icons/points

    Label-13px-Bold
      anchors.top: parent.top
      anchors.left: prev.right
      anchors.right: parent.right
      text-align: center
      text-auto-resize: true
      margin-top: 14
      !text: tr('Você ganha:')

    Label-14px-Regular
      id: count
      anchors.top: prev.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      text-auto-resize: true
      margin-top: 12
      !text: tr('09 pontos')

MainWindow
  size: 703 510
  !text: tr('Scout Club')
  visible: false
  icon: /images/game/icons/scout_phone
  icon-align: top
  icon-offset: -88 13
  icon-color: alpha
  @onEscape: self:hide()
  @onClose: self:hide()

  $on:
    icon-color: white

  Label-14px-Medium
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 18
    text-auto-resize: true
    !text: tr('Você pode selecionar até 3 opções simultâneas')

  Panel
    id: rankPanel
    height: 40
    anchors.top: prev.bottom       
    anchors.left: parent.left 
    background-color: alpha
    margin-top: 20
    @onSetup: |
      local width = 0
      for i, child in pairs(self:getChildren()) do
        width = width + child:getWidth() + child:getMarginLeft()
      end
      self:setWidth(width)

    ButtonScoutRank
      id: 1
      anchors.top: parent.top
      anchors.left: parent.left  
      text: Rookie

    ButtonScoutRank
      id: 2
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      text: Mentor

    ButtonScoutRank
      id: 3
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      text: Coordinator
      icon-offset: -8 0

    ButtonScoutRank
      id: 4
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      text: Coach

  TextEdit
    id: edtSearch
    anchors.top: prev.top
    anchors.left: prev.right
    anchors.right: parent.right
    margin-left: 8
    !placeholder: tr('Search') .. '...'
    @onTextChange: |
      function(self, text)
        self.placeholderLabel:setVisible(text:len() == 0)
        modules.game_scout.onSearchPokemon(text)
      end

  ScrollablePanel
    id: panelList
    anchors.top: prev.bottom
    anchors.bottom: next.bottom
    anchors.left: parent.left
    anchors.right: next.left
    vertical-scrollbar: scrollList
    margin-top: 10
    layout:
      type: grid
      cell-size: 325 95
      flow: true
      cell-spacing: 2

  VerticalScrollBar
    id: scrollList
    height: 86
    anchors.right: parent.right
    anchors.bottom: cancelButton.top
    anchors.top: edtSearch.bottom
    margin: 8 0 25 0
    step: 28
    pixels-scroll: true

  Label-16px-Bold
    id: pointsLabel
    size: 60 32
    anchors.verticalCenter: controlButton.verticalCenter
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-left: 12 
    icon: /images/game/icons/points
    icon-align: left
    text-auto-resize: true
    text-offset: 36 5

  Label-16px-Bold
    id: batteryLabel
    size: 60 32
    anchors.verticalCenter: prev.verticalCenter
    anchors.bottom: parent.bottom
    anchors.left: prev.right
    margin: 0 0 2 18 
    icon: /images/game/icons/battery
    icon-align: left
    text-auto-resize: true
    text-offset: 34 8
    text: 0

  ButtonRedSmall
    id: cancelButton
    width: 131
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-right: 12
    !text: tr("Cancel")
    @onClick: modules.game_scout.requestCancel()

  ButtonBlueSmall
    id: controlButton
    width: 131
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-right: 12
    !text: tr("Start")

    $on:
      !text: tr("Finish")