ScoutDungeoWindow < MainHeadlessWindow
  text: Scout Dungeon
  size: 624 286
  @onEscape: modules.game_scout.onCloseDungeonWindow()

  UIWidget
    id: image
    anchors.top: parent.top
    anchors.left: parent.left
    margin: -52 0 0 -14

  Label-16px-Regular
    id: message
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    text-wrap: true
    text-auto-resize: true
    margin: 12 56 0 56

  UIItem
    id: item
    size: 32 32
    anchors.bottom: next.bottom
    anchors.left: next.right
    virtual: true
    text-align: bottomright
    margin-left: 7

  Label-16px-Bold
    anchors.bottom: next.top
    anchors.left: parent.left
    margin-bottom: 23
    text-auto-resize: true
    text: Custo:

  ButtonRedSmall
    anchors.bottom: parent.bottom
    anchors.left: parent.horizontalCenter
    anchors.right: parent.right
    margin-left: 5
    !text: tr('Cancel')
    @onClick: modules.game_scout.onCloseDungeonWindow()

  ButtonBlueSmall
    id: iniciar
    anchors.bottom: parent.bottom
    anchors.right: parent.horizontalCenter
    anchors.left: parent.left
    margin-right: 5
    !text: tr('Iniciar')

ScoutReward < PanelRoundedSolid
  padding: 10
  image-color: #3C3C3C
  phantom: false
  @onHoverChange: |
    function(self, hovered)
      self.outline:setVisible(hovered)
    end

  Label-16px-Bold
    id: name
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    text-auto-resize: true
    text-align: center
    text-wrap: true

  ButtonBlueSmall
    id: points
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    @onHoverChange: |
      function(self, hovered)
        self:getParent().outline:setVisible(hovered)
      end

    UIItem
      id: medal
      size: 32 32
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 8
      virtual: true
      phantom: true

  PanelOutline
    id: outline
    anchors.fill: parent
    margin: -10
    image-clip: 0 60 170 60
    visible: false

ScoutRewardItem < ScoutReward

  UIItem
    id: item
    size: 45 45
    anchors.centerIn: parent
    virtual: true
    phantom: true

ScoutRewardCreature < ScoutReward

  UICreature
    id: creature
    size: 52 52
    anchors.centerIn: parent
    phantom: true

RewardsWindow < MainWindow
  size: 708 568
  text: Scout's Club Rewards
  visible: false
  @onEscape: self:hide()

  Label-14px-Medium
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    !text: tr('Escolha sua recompensa')
    text-auto-resize: true
    margin-top: 18

  Label-16px-Bold
    id: points
    height: 32
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    text: 10
    icon: /images/game/icons/points
    icon-align: left
    text-auto-resize: true
    text-offset: 36 2
    padding: 4

  ScrollablePanel
    id: list
    anchors.fill: parent
    anchors.top: next.top
    anchors.bottom: next.bottom
    anchors.right: next.left
    anchors.left: parent.left
    vertical-scrollbar: listScrollBar
    auto-focus: first
    layout:
      type: grid
      cell-size: 162 214
      cell-spacing: 4
      flow: true

  VerticalScrollBar
    id: listScrollBar
    anchors.top: points.bottom
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-top: 10
    step: 50
    pixels-scroll: true

