Panel
  id: graphicsPanel

  VerticalScrollBar
    id: scroll
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 14
    pixels-scroll: true

  PanelOption
    anchors.fill: parent
    anchors.right: prev.left
    vertical-scrollbar: scroll

    Label-13px-Regular
      text-auto-resize: true
      text-wrap: false
      @onSetup: |
        self:setText(tr("GPU: ") .. g_graphics.getRenderer())      

    Label-13px-Regular
      text-auto-resize: true
      text-wrap: false
      @onSetup: |
        self:setText(tr("Version: ") .. g_graphics.getVersion())      

    HorizontalSeparator
      id: separator
      margin: 5 5 5 5

    OptionCheckBox
      id: vsync
      !text: tr('Enable vertical synchronization')
      !tooltip: tr('Limits FPS (usually to 60)')

    OptionCheckBox
      id: showFps
      !text: tr('Show frame rate')

    OptionCheckBox
      id: enableLights
      !text: tr('Enable lights')

    OptionCheckBox
      id: hdmodeBox
      !text: tr('Enable HD Graphics')

    OptionCheckBox
      id: fullscreen
      !text: tr('Fullscreen')
      tooltip: Ctrl+Shift+F

    OptionCheckBox
      id: antialiasing
      !text: tr('Antialiasing')

    OptionCheckBox
      id: blurScreen
      !text: tr('Blur game screen when window is active')

    Label-14px-Medium
      margin-top: 12
      id: optimizationLevelLabel
      text-auto-resize: true
      !text: tr("Optimization level")
    
    ComboBox
      id: optimizationLevel
      margin-top: 2
      @onOptionChange: modules.client_options.setOption(self:getId(), self.currentIndex)
      @onSetup: |
        self:addOption(tr("Automatic"))
        self:addOption(tr("None"))
        self:addOption(tr("Low"))
        self:addOption(tr("Medium"))
        self:addOption(tr("High"))
        self:addOption(tr("Maximum"))
      
    Label-14px-Medium
      text-auto-resize: true
      !text: tr('High/Maximum optimization level may cause visual defects')
      margin-top: 5

    Label-14px-Medium
      id: backgroundFrameRateLabel
      !text: tr('Game framerate limit: %s', 'max')
      margin-top: 8
      @onSetup: |
        local value = modules.client_options.getOption('backgroundFrameRate')
        local text = value
        if value <= 0 or value >= 201 then
          text = 'max'
        end
        self:setText(tr('Game framerate limit: %s', text))

    OptionScrollbar
      id: backgroundFrameRate
      margin-top: 3
      minimum: 10
      maximum: 201

    Label-14px-Medium
      id: ambientLightLabel
      margin-top: 6
      @onSetup: |
        local value = modules.client_options.getOption('ambientLight')
        self:setText(tr('Ambient light: %s%%', value))

    OptionScrollbar
      id: ambientLight
      margin-top: 3
      minimum: 0
      maximum: 100

    Label-14px-Medium
      id: gameOpacityLabel
      margin-top: 6
      @onSetup: |
        local value = modules.client_options.getOption('gameOpacity')
        self:setText(tr('Opacidade de Efeitos e Mísseis: %s%%', value))

    OptionScrollbar
      id: gameOpacity
      margin-top: 3
      minimum: 0
      maximum: 100

    Label-14px-Medium
      id: tips
      margin-top: 20
      text-auto-resize: true
      text-align: left
      text-wrap: true
      !text: tr("If you have FPS issues:\n- Use OpenGL version (_gl)\n- Disable vertical synchronization\n- Set higher optimization level\n- Lower screen resolution")
      visible: false
