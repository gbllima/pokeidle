OptionCheckBox < CheckBox
  height: 19
  text-offset: 0 0
  font: DMSans-14px-medium
  image-source: ~
  @onCheckChange: |
    self.toggle:setChecked(self:isChecked())
    modules.client_options.setOption(self:getId(), self:isChecked())
  @onHoverChange: |
    function(self, hovered)
      self.toggle:setOn(hovered)
    end

  $!first:
    margin-top: 5

  $on:
    color: #FFFFFF  

  ToggleButton
    id: toggle
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    @onCheckChange: self:getParent():setChecked(self:isChecked())
    @onHoverChange: |
      function(self, hovered)
        self:getParent():setOn(hovered)
      end

    $checked on:
      image-clip: 0 54 40 18

    $!checked on:
      image-clip: 0 18 40 18

OptionScrollbar < HorizontalScrollBar
  step: 14
  @onValueChange: modules.client_options.setOption(self:getId(), self:getValue())

PanelOption < ScrollablePanel
  image-source: /images/ui/panel_rounded_solid
  image-border: 10
  image-color: #525252
  padding: 10
  layout:
    type: verticalBox

MainWindow
  id: optionsWindow
  !text: tr('Options')
  size: 815 426
  @onClose: g_settings.save() modules.client_options.hide()
  @onEnter: modules.client_options.hide()
  @onEscape: modules.client_options.hide()

  TabBarVertical
    id: optionsTabBar
    width: 236
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-top: 18

  Panel
    id: optionsTabContent
    anchors.top: optionsTabBar.top
    anchors.left: optionsTabBar.right
    anchors.right: parent.right
    anchors.bottom: optionsTabBar.bottom
    margin-left: 10